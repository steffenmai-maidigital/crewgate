{
    "name": "crewgate/crewgate",
    "type": "project",
    "description": "CrewGate – HR-Prozessportal (Einstellung, Stellenwechsel, Austritt) mit eigenen Konten und optionaler AD/LDAP-Anmeldung (Laravel, Docker, SQLite)",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.0",
        "laravel/framework": "^13.0",
        "dompdf/dompdf": "^3.1",
        "league/commonmark": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
